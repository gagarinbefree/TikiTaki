{
  "name": "tikitaki",
  "version": "0.1.8",
  "description": "Zero-runtime-dependency navigation for a ragged 2D swipe grid",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "API.md",
    "ARCHITECTURE.md",
    "TESTING.md",
    "PUBLISHING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "typecheck": "vue-tsc --noEmit && svelte-check --config ./svelte.config.js --tsconfig ./tsconfig.svelte.json --fail-on-warnings && ngc -p demos/angular/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:core": "node scripts/build.mjs tsconfig.build.json",
    "build:adapters": "node scripts/build.mjs packages/react/tsconfig.build.json packages/vue/tsconfig.build.json packages/svelte/tsconfig.build.json packages/angular/tsconfig.build.json",
    "build": "npm run build:core && npm run build:adapters",
    "demo": "npm run build:angular-demo && vite --configLoader native",
    "demo:build": "npm run build:angular-demo && vite build --configLoader native",
    "demo:preview": "vite preview --configLoader native",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:browser": "npm run build && npm run demo:build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:browser && node scripts/check-package.mjs",
    "build:angular-demo": "ngc -p demos/angular/tsconfig.json",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:pack": "node scripts/pack-release.mjs",
    "release:publish": "node scripts/publish-release.mjs",
    "release:test-consumer": "node scripts/check-release-consumer.mjs"
  },
  "devDependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-vue": "6.0.10",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "lit": "3.3.3",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rxjs": "7.8.2",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  },
  "license": "MIT",
  "author": "gagarinbefree",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gagarinbefree/TikiTaki.git"
  },
  "homepage": "https://github.com/gagarinbefree/TikiTaki#readme",
  "bugs": {
    "url": "https://github.com/gagarinbefree/TikiTaki/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "swipe",
    "gestures",
    "typescript",
    "ragged-grid"
  ]
}
