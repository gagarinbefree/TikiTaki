{
  "name": "tikitaki",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "Zero-runtime-dependency navigation for a ragged 2D swipe grid",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "API.md",
    "ARCHITECTURE.md",
    "TESTING.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "vitest run --configLoader native",
    "test:watch": "vitest --configLoader native",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "build:core": "node scripts/build.mjs tsconfig.build.json",
    "build:adapters": "node scripts/build.mjs packages/react/tsconfig.build.json packages/vue/tsconfig.build.json",
    "build": "npm run build:core && npm run build:adapters",
    "demo": "vite --configLoader native",
    "demo:build": "vite build --configLoader native",
    "demo:preview": "vite preview --configLoader native",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:browser": "npm run build && npm run demo:build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:browser && node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "vue": "3.5.44"
  }
}
