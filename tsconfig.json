{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "skipLibCheck": false,
    "types": ["node"],
    "paths": {
      "tikitaki": ["./src/index.ts"],
      "tikitaki/dom": ["./src/dom.ts"],
      "@tikitaki_gagarinbefree/react": ["./packages/react/src/index.ts"],
      "@tikitaki_gagarinbefree/vue": ["./packages/vue/src/index.ts"],
      "@tikitaki_gagarinbefree/svelte": ["./packages/svelte/src/index.ts"],
      "@tikitaki_gagarinbefree/angular": ["./packages/angular/src/index.ts"],
      "@demo/angular": ["./demos/angular/App.ts"]
    },
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "packages/*/src/**/*.ts",
    "demos/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "demos/**/*.tsx",
    "demos/**/*.vue",
    "demos/vanilla/**/*.js"
  ],
  "vueCompilerOptions": { "strictTemplates": true, "dataAttributes": ["data-*"] },
  "exclude": ["demos/angular/**"]
}
